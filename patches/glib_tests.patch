diff --git a/glib/tests/testing.c b/glib/tests/testing.c
index eaa5b08..e1136a5 100644
--- a/glib/tests/testing.c
+++ b/glib/tests/testing.c
@@ -43,6 +43,31 @@
 #include <unistd.h>
 #endif
 
+#ifdef __MVS__
+static int dupfd_cloexec(int oldfd, int minfd) {
+    int newfd = fcntl(oldfd, F_DUPFD, minfd);
+    if (newfd == -1) {
+        perror("fcntl(F_DUPFD) failed");
+        return -1;
+    }
+
+    int flags = fcntl(newfd, F_GETFD);
+    if (flags == -1) {
+        perror("fcntl(F_GETFD) failed");
+        close(newfd);
+        return -1;
+    }
+
+    if (fcntl(newfd, F_SETFD, flags | FD_CLOEXEC) == -1) {
+        perror("fcntl(F_SETFD) failed");
+        close(newfd);
+        return -1;
+    }
+
+    return newfd;
+}
+#endif
+
 #define TAP_VERSION G_STRINGIFY (14)
 #define TAP_SUBTEST_PREFIX "    "
 
@@ -468,7 +493,11 @@ test_subprocess_stdin (void)
     }
 
   /* Temporarily override this process’ stdin with a pipe. */
+#if !defined(__MVS__)
   old_stdin_fd = fcntl (STDIN_FILENO, F_DUPFD_CLOEXEC, 0);
+#else
+  old_stdin_fd = dupfd_cloexec (STDIN_FILENO, 0);
+#endif
   g_assert_cmpint (old_stdin_fd, >=, 0);
 
   g_unix_open_pipe (pipe_fd, O_CLOEXEC, &local_error);
